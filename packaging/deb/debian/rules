#!/usr/bin/make -f
# -*- makefile -*-
# SPOCK2 Debian packaging (dh + pip wheel)
#
# Build aus Repo-Root (empfohlen):
#   ln -sfn packaging/deb/debian debian
#   dpkg-buildpackage -us -uc -b
#
# Siehe packaging/deb/README.md

export DH_VERBOSE = 1
export PYBUILD_NAME = spock2

%:
	dh $@ --with python3

override_dh_auto_clean:
	dh_auto_clean || true
	rm -rf build dist *.egg-info src/*.egg-info 2>/dev/null || true

override_dh_auto_build:
	python3 -m pip install --upgrade 'pip>=24' 'build>=1.0' wheel
	python3 -m build --wheel --outdir dist

override_dh_auto_install:
	python3 -m pip install --no-deps --root=$(CURDIR)/debian/spock2 \
		--prefix=/usr \
		$(CURDIR)/dist/spock2-*.whl
	# Deploy-Artefakte (ergänzend zu debian/spock2.install)
	install -d $(CURDIR)/debian/spock2/etc/spock2
	install -m 0644 $(CURDIR)/config/spock2.example.toml \
		$(CURDIR)/debian/spock2/etc/spock2/spock2.toml.example
	install -d $(CURDIR)/debian/spock2/lib/udev/rules.d
	install -m 0644 $(CURDIR)/deploy/udev/99-spock-printers.rules \
		$(CURDIR)/debian/spock2/lib/udev/rules.d/
	install -d $(CURDIR)/debian/spock2/usr/lib/systemd/system
	install -m 0644 $(CURDIR)/deploy/systemd/spock2.service \
		$(CURDIR)/debian/spock2/usr/lib/systemd/system/
	install -d $(CURDIR)/debian/spock2/usr/lib/systemd/user
	install -m 0644 $(CURDIR)/deploy/systemd/spock2.user.service \
		$(CURDIR)/debian/spock2/usr/lib/systemd/user/spock2.service
	install -d $(CURDIR)/debian/spock2/usr/share/spock2/kiosk
	install -m 0755 $(CURDIR)/deploy/kiosk/spock2-session.sh \
		$(CURDIR)/debian/spock2/usr/share/spock2/kiosk/
	install -m 0644 $(CURDIR)/deploy/kiosk/spock2.desktop \
		$(CURDIR)/debian/spock2/usr/share/spock2/kiosk/
	install -d $(CURDIR)/debian/spock2/usr/share/applications
	install -m 0644 $(CURDIR)/deploy/kiosk/spock2.desktop \
		$(CURDIR)/debian/spock2/usr/share/applications/
	install -d $(CURDIR)/debian/spock2/usr/share/pixmaps
	install -m 0644 $(CURDIR)/src/spock2/ui/resources/spock2_icon_256.png \
		$(CURDIR)/debian/spock2/usr/share/pixmaps/spock2.png
	install -d $(CURDIR)/debian/spock2/usr/share/icons/hicolor/256x256/apps
	install -m 0644 $(CURDIR)/src/spock2/ui/resources/spock2_icon_256.png \
		$(CURDIR)/debian/spock2/usr/share/icons/hicolor/256x256/apps/spock2.png
	install -d $(CURDIR)/debian/spock2/usr/share/doc/spock2
	install -m 0644 $(CURDIR)/README.md \
		$(CURDIR)/debian/spock2/usr/share/doc/spock2/
	install -m 0644 $(CURDIR)/deploy/cups/README.md \
		$(CURDIR)/debian/spock2/usr/share/doc/spock2/cups-README.md
	install -m 0644 $(CURDIR)/deploy/cups/spock-queues.conf.example \
		$(CURDIR)/debian/spock2/usr/share/doc/spock2/

override_dh_auto_test:
	@echo "Skipping dh_auto_test (run pytest in CI)"

override_dh_install:
	# Dateien bereits in override_dh_auto_install; .install als Doku behalten
	@true
