# Install-Liste relativ zum Repo-Root (nach: ln -sfn packaging/deb/debian debian).
# Primäre Installation läuft in debian/rules (override_dh_auto_install);
# diese Datei dokumentiert die Zielorte und kann als Alternative zu den
# install-Aufrufen in rules genutzt werden (dann override_dh_install entfernen).

config/spock2.example.toml etc/spock2/spock2.toml.example
deploy/udev/99-spock-printers.rules lib/udev/rules.d/
deploy/systemd/spock2.service usr/lib/systemd/system/
deploy/systemd/spock2.user.service usr/lib/systemd/user/spock2.service
deploy/kiosk/spock2-session.sh usr/share/spock2/kiosk/
deploy/kiosk/spock2.desktop usr/share/spock2/kiosk/
deploy/kiosk/spock2.desktop usr/share/applications/
README.md usr/share/doc/spock2/
deploy/cups/README.md usr/share/doc/spock2/cups-README.md
deploy/cups/spock-queues.conf.example usr/share/doc/spock2/
