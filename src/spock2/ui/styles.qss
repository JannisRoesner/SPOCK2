/* SPOCK2 – Küchen-Kiosk, hell, hoher Kontrast, touch-freundlich
 *
 * Basisgrößen sind bewusst kompakt: theme.py skaliert sie zur Laufzeit
 * anhand von Bildschirm-/Fenstergröße und [ui] ui_scale.
 *
 * Tokens:
 *   window  #f4f4f0
 *   panel   #ffffff
 *   raised  #ecece4
 *   border  #b0b0a8
 *   text    #1a1a1a
 *   muted   #666666
 *   accent  #b35c00
 *   ok      #1a7a3c
 *   warn    #b35c00 / #ffcc66
 *   err     #a10000 / #ff8a80
 */

* {
    font-family: "Segoe UI", "DejaVu Sans", "Noto Sans", sans-serif;
}

QMainWindow, QDialog {
    background-color: #f4f4f0;
    color: #1a1a1a;
}

QWidget#centralRoot {
    background-color: #f4f4f0;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QLabel {
    color: #1a1a1a;
}

QLabel#emptyState {
    font-size: 16pt;
    font-weight: 600;
    color: #555555;
    padding: 12px 24px 24px 24px;
}

QLabel#emptyLogo {
    padding: 8px;
}

QLabel#emptyStateHint {
    font-size: 11pt;
    color: #666666;
    padding: 4px 24px 24px 24px;
}

QLabel#adminHint,
QLabel#fieldWarn {
    font-size: 9pt;
    font-weight: 400;
    color: #666666;
    padding: 2px 0px;
}

QLabel#fieldWarn {
    color: #b35c00;
}

/* --- Problem-/Hinweisbanner --- */
QFrame#problemBanner {
    background-color: #ffe4e0;
    border-bottom: 2px solid #a10000;
}

QFrame#hintBanner {
    background-color: #e4f2e8;
    border-bottom: 2px solid #1a7a3c;
}

QLabel#problemBannerText {
    font-size: 11pt;
    font-weight: 700;
    color: #1a1a1a;
}

QPushButton#bannerButton {
    min-height: 26px;
    min-width: 52px;
    font-size: 10pt;
    padding: 2px 10px;
}

/* --- Order Card --- */
QFrame#orderCard {
    background-color: #ffffff;
    border: 1px solid #b0b0a8;
    border-radius: 8px;
}

QLabel#tableNumber {
    font-size: 22pt;
    font-weight: 800;
    color: #111111;
}

QLabel#waitTime {
    font-size: 12pt;
    font-weight: 700;
    color: #b35c00;
}

QLabel#waitTimeHot {
    font-size: 12pt;
    font-weight: 800;
    color: #a10000;
}

QLabel#orderMeta {
    font-size: 9pt;
    color: #333333;
}

QLabel#itemLine {
    font-size: 12pt;
    font-weight: 600;
    color: #111111;
}

QLabel#itemNotes {
    font-size: 10pt;
    color: #444444;
    font-style: italic;
}

QLabel#categoryHeader {
    font-size: 8pt;
    font-weight: 700;
    color: #555555;
    text-transform: uppercase;
    padding-top: 4px;
}

/* --- Buttons --- */
QPushButton {
    min-height: 40px;
    min-width: 80px;
    font-size: 11pt;
    font-weight: 700;
    border: 1px solid #b0b0a8;
    border-radius: 6px;
    padding: 4px 10px;
    background-color: #ecece4;
    color: #111111;
}

QPushButton:hover {
    background-color: #ddd8c8;
    border-color: #8a8a82;
}

QPushButton:pressed {
    background-color: #cfc9b8;
}

QPushButton:disabled {
    color: #888888;
    border-color: #cccccc;
    background-color: #e8e8e8;
}

QPushButton#doneButton {
    background-color: #1a7a3c;
    color: #ffffff;
    border-color: #1a7a3c;
}

QPushButton#doneButton:hover {
    background-color: #156533;
    border-color: #156533;
}

QPushButton#doneButton:pressed {
    background-color: #0f4d26;
    border-color: #0f4d26;
}

QPushButton#reprintButton {
    background-color: #fff8e6;
    border-color: #d4a04a;
    color: #7a3e00;
}

QPushButton#reprintButton:hover {
    background-color: #ffe8b8;
    border-color: #b35c00;
}

QPushButton#secondaryButton {
    background-color: #ffffff;
    border-color: #b0b0a8;
    color: #111111;
}

QPushButton#secondaryButton:hover {
    background-color: #ecece4;
    border-color: #8a8a82;
}

QPushButton#primaryButton {
    background-color: #1a1a1a;
    color: #ffffff;
    border-color: #1a1a1a;
}

QPushButton#primaryButton:hover {
    background-color: #333333;
    border-color: #333333;
}

QPushButton#dangerButton {
    background-color: #a10000;
    color: #ffffff;
    border-color: #a10000;
}

/* --- Status bar --- */
QFrame#statusBar {
    background-color: #1a1a1a;
    border-top: 1px solid #5a5a54;
    min-height: 30px;
}

QLabel#statusLogo {
    padding: 1px 6px 1px 2px;
}

QLabel#statusLabel {
    color: #f4f4f0;
    font-size: 9pt;
    font-weight: 600;
    padding: 2px 4px;
}

QLabel#statusOk {
    color: #7dffa0;
    font-size: 9pt;
    font-weight: 700;
    padding: 2px 4px;
}

QLabel#statusWarn {
    color: #ffcc66;
    font-size: 9pt;
    font-weight: 700;
    padding: 2px 4px;
}

QLabel#statusErr {
    color: #ff8a80;
    font-size: 9pt;
    font-weight: 700;
    padding: 2px 4px;
}

/* --- Menu --- */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #b0b0a8;
    font-size: 10pt;
    min-height: 26px;
}

QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
    color: #1a1a1a;
}

QMenuBar::item:selected {
    background-color: #ffe8b8;
    color: #111111;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #b0b0a8;
    font-size: 11pt;
    color: #111111;
}

QMenu::item {
    padding: 8px 18px;
    min-height: 30px;
    color: #111111;
    background-color: #ffffff;
}

QMenu::item:selected {
    background-color: #ffe8b8;
    color: #111111;
}

/* Dialog-Standardbuttons */
QDialogButtonBox QPushButton {
    min-height: 40px;
    min-width: 100px;
    font-size: 11pt;
    font-weight: 700;
    border: 1px solid #b0b0a8;
    border-radius: 6px;
    padding: 4px 12px;
    background-color: #ecece4;
    color: #111111;
}

QDialogButtonBox QPushButton:hover {
    background-color: #ddd8c8;
    border-color: #8a8a82;
}

QDialogButtonBox QPushButton:default,
QDialogButtonBox QPushButton#primaryButton {
    background-color: #1a1a1a;
    color: #ffffff;
    border-color: #1a1a1a;
}

QDialogButtonBox QPushButton:default:hover,
QDialogButtonBox QPushButton#primaryButton:hover {
    background-color: #333333;
    border-color: #333333;
}

/* --- Dialogs --- */
QDialog QLabel#dialogTitle {
    font-size: 13pt;
    font-weight: 800;
    padding-bottom: 4px;
}

QTextEdit, QPlainTextEdit, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    font-size: 11pt;
    border: 1px solid #b0b0a8;
    border-radius: 6px;
    padding: 4px 8px;
    background-color: #ffffff;
    color: #111111;
    min-height: 28px;
    selection-background-color: #ffe8b8;
    selection-color: #111111;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #b35c00;
}

/* Editable combo: kein Fusion-Doppelrahmen */
QComboBox:editable {
    padding: 0px;
}

QComboBox:editable QLineEdit {
    border: none;
    background: transparent;
    padding: 4px 8px;
    min-height: 28px;
    color: #111111;
    selection-background-color: #ffe8b8;
    selection-color: #111111;
}

/* drop-down / down-arrow bewusst ungestylt: sobald man sie per QSS anfasst,
   zeichnet Qt den Pfeil nicht mehr selbst und das Feld sieht aus wie ein
   leerer Strich – genau der Effekt im Fehlerbericht. */

QComboBox QAbstractItemView {
    font-size: 11pt;
    border: 1px solid #b0b0a8;
    background-color: #ffffff;
    color: #111111;
    selection-background-color: #ffe8b8;
    selection-color: #111111;
    outline: 0;
}

QCheckBox, QGroupBox, QTabWidget, QTabBar::tab {
    color: #111111;
}

QCheckBox {
    spacing: 8px;
    font-size: 11pt;
    min-height: 26px;
}

QTabWidget::pane {
    border: 1px solid #b0b0a8;
    border-radius: 0px 6px 6px 6px;
    background-color: #ffffff;
    top: -1px;
    padding: 6px;
}

QTabBar::tab {
    background-color: #ecece4;
    border: 1px solid #b0b0a8;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 12px;
    margin-right: 3px;
    min-height: 26px;
    font-size: 10pt;
    color: #555555;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #111111;
    font-weight: 700;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

QTabBar::tab:hover:!selected {
    background-color: #ddd8c8;
    color: #111111;
}

QGroupBox {
    font-weight: 700;
    font-size: 10pt;
    border: 1px solid #b0b0a8;
    border-radius: 6px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0px 4px;
    color: #555555;
}

QFrame#notePopupFrame {
    background-color: #fff8e6;
    border: 2px solid #b35c00;
    border-radius: 10px;
}

QLabel#notePopupTitle {
    font-size: 15pt;
    font-weight: 800;
    color: #7a3e00;
}

QLabel#notePopupBody {
    font-size: 12pt;
    color: #1a1a1a;
}
