/* SPOCK2 – Küchen-Kiosk, dunkel, hoher Kontrast, touch-freundlich
 *
 * Tokens:
 *   window  #1c1c1a
 *   panel   #2a2a28
 *   raised  #3a3a36
 *   border  #5a5a54
 *   text    #f0f0ec
 *   muted   #999990
 *   accent  #b35c00
 *   ok      #7dffa0 / #1a7a3c
 *   warn    #ffcc66 / #ffb84d
 *   err     #ff8a80 / #a10000
 */

* {
    font-family: "Segoe UI", "DejaVu Sans", "Noto Sans", sans-serif;
}

QMainWindow, QDialog {
    background-color: #1c1c1a;
    color: #f0f0ec;
}

QWidget#centralRoot {
    background-color: #1c1c1a;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QLabel {
    color: #f0f0ec;
}

QLabel#emptyState {
    font-size: 22pt;
    font-weight: 600;
    color: #b0b0a8;
    padding: 24px 48px 48px 48px;
}

QLabel#emptyLogo {
    padding: 8px;
}

QLabel#emptyStateHint {
    font-size: 14pt;
    color: #999990;
    padding: 8px 48px 48px 48px;
}

QLabel#adminHint,
QLabel#fieldWarn {
    font-size: 12pt;
    font-weight: 400;
    color: #999990;
    padding: 4px 0px;
}

QLabel#fieldWarn {
    color: #ffcc66;
}

/* --- Order Card --- */
QFrame#orderCard {
    background-color: #2a2a28;
    border: 1px solid #5a5a54;
    border-radius: 10px;
    margin: 6px;
}

QLabel#tableNumber {
    font-size: 36pt;
    font-weight: 800;
    color: #ffffff;
}

QLabel#waitTime {
    font-size: 16pt;
    font-weight: 700;
    color: #ffb84d;
}

QLabel#waitTimeHot {
    font-size: 16pt;
    font-weight: 800;
    color: #ff6b6b;
}

QLabel#orderMeta {
    font-size: 12pt;
    color: #c8c8c0;
}

QLabel#itemLine {
    font-size: 15pt;
    font-weight: 600;
    color: #f0f0ec;
}

QLabel#itemNotes {
    font-size: 12pt;
    color: #b0b0a8;
    font-style: italic;
}

QLabel#categoryHeader {
    font-size: 11pt;
    font-weight: 700;
    color: #999990;
    text-transform: uppercase;
    padding-top: 6px;
}

/* --- Buttons --- */
QPushButton {
    min-height: 56px;
    min-width: 120px;
    font-size: 14pt;
    font-weight: 700;
    border: 1px solid #5a5a54;
    border-radius: 8px;
    padding: 8px 16px;
    background-color: #3a3a36;
    color: #f0f0ec;
}

QPushButton:hover {
    background-color: #4a4a44;
    border-color: #7a7a72;
}

QPushButton:pressed {
    background-color: #2a2a28;
}

QPushButton:disabled {
    color: #777770;
    border-color: #444440;
    background-color: #2a2a28;
}

QPushButton#doneButton {
    background-color: #1a7a3c;
    color: #ffffff;
    border-color: #1a7a3c;
}

QPushButton#doneButton:hover {
    background-color: #1f8f47;
    border-color: #1f8f47;
}

QPushButton#doneButton:pressed {
    background-color: #0f4d26;
    border-color: #0f4d26;
}

QPushButton#reprintButton {
    background-color: #3d2e14;
    border-color: #8a6020;
    color: #ffcc66;
}

QPushButton#reprintButton:hover {
    background-color: #4d3a1a;
    border-color: #b35c00;
}

QPushButton#secondaryButton {
    background-color: #2a2a28;
    border-color: #5a5a54;
    color: #f0f0ec;
}

QPushButton#secondaryButton:hover {
    background-color: #3a3a36;
    border-color: #7a7a72;
}

QPushButton#primaryButton {
    background-color: #e8e8e0;
    color: #111111;
    border-color: #e8e8e0;
}

QPushButton#primaryButton:hover {
    background-color: #ffffff;
    border-color: #ffffff;
}

QPushButton#dangerButton {
    background-color: #a10000;
    color: #ffffff;
    border-color: #a10000;
}

/* --- Status bar --- */
QFrame#statusBar {
    background-color: #121210;
    border-top: 1px solid #5a5a54;
    min-height: 52px;
}

QLabel#statusLogo {
    padding: 2px 8px 2px 4px;
}

QLabel#statusLabel {
    color: #f4f4f0;
    font-size: 12pt;
    font-weight: 600;
    padding: 4px 12px;
}

QLabel#statusOk {
    color: #7dffa0;
    font-size: 12pt;
    font-weight: 700;
    padding: 4px 12px;
}

QLabel#statusWarn {
    color: #ffcc66;
    font-size: 12pt;
    font-weight: 700;
    padding: 4px 12px;
}

QLabel#statusErr {
    color: #ff8a80;
    font-size: 12pt;
    font-weight: 700;
    padding: 4px 12px;
}

/* --- Menu --- */
QMenuBar {
    background-color: #2a2a28;
    border-bottom: 1px solid #5a5a54;
    font-size: 13pt;
    min-height: 40px;
}

QMenuBar::item {
    padding: 8px 16px;
    background: transparent;
    color: #f0f0ec;
}

QMenuBar::item:selected {
    background-color: #b35c00;
    color: #ffffff;
}

QMenu {
    background-color: #2a2a28;
    border: 1px solid #5a5a54;
    font-size: 13pt;
    color: #f0f0ec;
}

QMenu::item {
    padding: 12px 24px;
    min-height: 40px;
    color: #f0f0ec;
    background-color: #2a2a28;
}

QMenu::item:selected {
    background-color: #b35c00;
    color: #ffffff;
}

/* Dialog-Standardbuttons */
QDialogButtonBox QPushButton {
    min-height: 56px;
    min-width: 120px;
    font-size: 14pt;
    font-weight: 700;
    border: 1px solid #5a5a54;
    border-radius: 8px;
    padding: 8px 16px;
    background-color: #3a3a36;
    color: #f0f0ec;
}

QDialogButtonBox QPushButton:hover {
    background-color: #4a4a44;
    border-color: #7a7a72;
}

QDialogButtonBox QPushButton:default,
QDialogButtonBox QPushButton#primaryButton {
    background-color: #e8e8e0;
    color: #111111;
    border-color: #e8e8e0;
}

QDialogButtonBox QPushButton:default:hover,
QDialogButtonBox QPushButton#primaryButton:hover {
    background-color: #ffffff;
    border-color: #ffffff;
}

/* --- Dialogs --- */
QDialog QLabel#dialogTitle {
    font-size: 20pt;
    font-weight: 800;
    color: #f0f0ec;
    padding-bottom: 12px;
}

QTextEdit, QPlainTextEdit, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    font-size: 14pt;
    border: 1px solid #5a5a54;
    border-radius: 8px;
    padding: 8px 12px;
    background-color: #2a2a28;
    color: #f0f0ec;
    min-height: 40px;
    selection-background-color: #b35c00;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #b35c00;
}

/* Editable combo: kein Fusion-Doppelrahmen */
QComboBox:editable {
    padding: 0px;
}

QComboBox:editable QLineEdit {
    border: none;
    background: transparent;
    padding: 8px 12px;
    min-height: 40px;
    color: #f0f0ec;
    selection-background-color: #b35c00;
    selection-color: #ffffff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 40px;
    border: none;
    border-left: 1px solid #5a5a54;
    background: transparent;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    font-size: 14pt;
    border: 1px solid #5a5a54;
    background-color: #2a2a28;
    color: #f0f0ec;
    selection-background-color: #b35c00;
    selection-color: #ffffff;
    outline: 0;
}

QCheckBox, QGroupBox, QTabWidget, QTabBar::tab {
    color: #f0f0ec;
}

QCheckBox {
    spacing: 10px;
}

QTabWidget::pane {
    border: 1px solid #5a5a54;
    border-radius: 0px 8px 8px 8px;
    background-color: #2a2a28;
    top: -1px;
    padding: 12px;
}

QTabBar::tab {
    background-color: #242422;
    border: 1px solid #5a5a54;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 18px;
    margin-right: 4px;
    min-height: 40px;
    color: #c8c8c0;
}

QTabBar::tab:selected {
    background-color: #2a2a28;
    color: #f0f0ec;
    font-weight: 700;
}

QTabBar::tab:!selected {
    margin-top: 4px;
}

QTabBar::tab:hover:!selected {
    background-color: #3a3a36;
    color: #f0f0ec;
}

QGroupBox {
    font-weight: 700;
    border: 1px solid #5a5a54;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    color: #f0f0ec;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0px 6px;
    color: #c8c8c0;
}

QFrame#notePopupFrame {
    background-color: #3d2e14;
    border: 2px solid #b35c00;
    border-radius: 10px;
}

QLabel#notePopupTitle {
    font-size: 22pt;
    font-weight: 800;
    color: #ffcc66;
}

QLabel#notePopupBody {
    font-size: 16pt;
    color: #f0f0ec;
}
